@page
@model UnifiedFreelanceArtisansDirectory.Areas.Client.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

@if (Model.Notifications.Count == 0)
{
    <div class="artisan-card card-flat">
        <p style="margin:0;color:var(--color-text-muted);">Nothing new yet — accept, decline, and completion updates on your requests will show up here.</p>
    </div>
}
else
{
    <div class="artisan-card card-flat">
        <ul style="list-style:none;padding:0;margin:0;">
            @foreach (var item in Model.Notifications)
            {
                <li style="padding:0.85rem 0;border-bottom:1px solid var(--color-gray-100);display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;">
                    <div>
                        <div style="font-weight:@(item.IsRead ? "500" : "700");">@item.Title</div>
                        <div style="color:var(--color-text-muted);margin-top:0.2rem;">
                            @if (!string.IsNullOrEmpty(item.LinkUrl))
                            {
                                <a href="@item.LinkUrl">@item.Message</a>
                            }
                            else
                            {
                                @item.Message
                            }
                        </div>
                    </div>
                    <span style="color:var(--color-gray-400);font-size:0.85rem;white-space:nowrap;">@item.CreatedOn.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                </li>
            }
        </ul>
    </div>
}
