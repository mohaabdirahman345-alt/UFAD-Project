@page
@model UnifiedFreelanceArtisansDirectory.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

    <p class="text-muted">Every account on the platform, with the ability to deactivate an account or reset user credentials.</p>
    <table class="table-artisan">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge-artisan badge-neutral">@user.Role</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge-artisan badge-verified">Active</span>
                        }
                        else
                        {
                            <span class="badge-artisan badge-pending">Deactivated</span>
                        }
                    </td>
                    <td>
                        @if (user.Role != "Administrator")
                        {
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn-artisan-outline btn-sm-artisan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPasswordModal"
                                        data-userid="@user.Id"
                                        data-username="@user.FullName"
                                        data-useremail="@user.Email">
                                    Reset Password
                                </button>
                                <form method="post" asp-page-handler="ToggleActive" asp-route-userId="@user.Id" asp-route-isActive="@user.IsActive"
                                      data-confirm="@(user.IsActive ? "Deactivate this account?" : "Reactivate this account?")">
                                    <button type="submit" class="btn-artisan-outline btn-sm-artisan" style="color: @(user.IsActive ? "#dc2626" : "#16a34a");">@(user.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 12px; border: 1px solid #e2e8f0;">
            <form method="post" asp-page-handler="ResetPassword">
                <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                    <h5 class="modal-title" id="resetPasswordModalLabel" style="font-weight: 700; color: #1e293b;">Reset User Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 1.5rem;">
                    <input type="hidden" name="userId" id="modalUserId" />
                    <p style="color: #475569; margin-bottom: 1rem;">
                        Resetting password for: <strong id="modalUserName" style="color: #1e293b;"></strong><br/>
                        <span style="font-size: 0.9rem; color: #64748b;">Email: <span id="modalUserEmail"></span></span>
                    </p>
                    <div class="mb-3">
                        <label for="modalNewPassword" class="form-label" style="font-weight: 600; color: #1e293b;">New Temporary Password</label>
                        <input type="text" class="form-control" name="newPassword" id="modalNewPassword" value="Garowe@2026" required style="border-radius: 8px;" />
                        <div class="form-text" style="font-size: 0.8rem; color: #64748b; margin-top: 0.35rem;">
                            Must be at least 8 characters, include 1 uppercase, 1 digit, and 1 symbol.
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="background: #2563eb; border: none; border-radius: 8px; font-weight: 600; padding: 0.5rem 1.25rem;">Confirm Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var resetModal = document.getElementById('resetPasswordModal');
            if (resetModal) {
                resetModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var userId = button.getAttribute('data-userid');
                    var userName = button.getAttribute('data-username');
                    var userEmail = button.getAttribute('data-useremail');

                    document.getElementById('modalUserId').value = userId;
                    document.getElementById('modalUserName').textContent = userName;
                    document.getElementById('modalUserEmail').textContent = userEmail;
                    document.getElementById('modalNewPassword').value = 'Garowe@2026';
                });
            }
        });
    </script>
}
