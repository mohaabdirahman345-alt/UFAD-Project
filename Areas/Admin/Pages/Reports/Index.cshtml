@page
@model UnifiedFreelanceArtisansDirectory.Areas.Admin.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports Queue";
}

<div style="max-width:820px;">
    <p class="text-muted">Reports filed by clients or providers, waiting on a decision.</p>
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert-artisan alert-artisan-success">@Model.StatusMessage</div>
    }

    @if (Model.PendingReports.Count == 0)
    {
        <p style="color:var(--color-text-secondary);">No reports are waiting on review.</p>
    }
    else
    {
        @foreach (var report in Model.PendingReports)
        {
            <div class="artisan-card card-flat mb-3">
                <div class="d-flex justify-content-between flex-wrap">
                    <div>
                        <strong>Reported: @report.ReportedUser.FullName</strong>
                        <span class="badge-artisan badge-pending ms-2">@report.Reason</span>
                    </div>
                    <span style="font-size:0.8rem;color:var(--color-text-secondary);">@report.CreatedOn.ToString("MMMM d, yyyy")</span>
                </div>
                <p style="margin:0.5rem 0;">@report.Details</p>
                <span style="font-size:0.85rem;color:var(--color-text-secondary);">Filed by @report.ReporterUser.FullName</span>

                <form method="post" class="artisan-form mt-2" style="border-top:1px solid var(--color-border);padding-top:0.75rem;">
                    <input type="hidden" name="reportId" value="@report.Id" />
                    <label>Resolution notes</label>
                    <textarea class="form-control" name="notes" rows="2" required></textarea>
                    <div class="d-flex gap-2">
                        <button type="submit" asp-page-handler="Resolve" class="btn-artisan-primary btn-sm-artisan">Mark Resolved</button>
                        <button type="submit" asp-page-handler="Dismiss" class="btn-artisan-outline btn-sm-artisan">Dismiss</button>
                    </div>
                </form>
            </div>
        }
    }
</div>
