@page
@model UnifiedFreelanceArtisansDirectory.Areas.ServiceProvider.Pages.CV.ManageModel
@{
    ViewData["Title"] = "Professional CV / Resume";
}

<div style="max-width:720px;">
    <h2 style="margin-bottom:0.5rem;">Professional CV / Resume</h2>
    <p class="text-muted">Upload your CV to provide additional information about your qualifications, experience, and professional background.</p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert-artisan alert-artisan-success">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-artisan alert-artisan-danger">@Model.ErrorMessage</div>
    }

    <div class="artisan-card">
        @if (Model.CurrentCV is null)
        {
            <p style="color: var(--color-secondary-text); margin-bottom: 1.5rem;">No CV uploaded yet.</p>

            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="artisan-form">
                <div class="form-group">
                    <label for="cvFile">Choose CV / Resume</label>
                    <input type="file" id="cvFile" name="cvFile" accept=".pdf,.doc,.docx" class="form-control" required />
                    <div class="field-hint">
                        Accepted formats: PDF, DOC, DOCX<br />
                        Maximum size: 10 MB
                    </div>
                </div>
                <button type="submit" class="btn-artisan-primary">Upload CV</button>
            </form>
        }
        else
        {
            <div style="background: var(--color-background); padding: 1rem; border-radius: 0.5rem; border-left: 4px solid var(--color-primary); margin-bottom: 1.5rem;">
                <p style="margin: 0; color: var(--color-secondary-text); font-size: 0.875rem;">Current CV</p>
                <p style="margin: 0.5rem 0 0 0; font-weight: 500; color: var(--color-primary-text);">@Model.CurrentCV.OriginalFileName</p>
                <p style="margin: 0.5rem 0 0 0; font-size: 0.875rem; color: var(--color-secondary-text);">
                    Uploaded: @Model.CurrentCV.UploadedAt.ToString("dd MMMM yyyy") |
                    Size: @FormatFileSize(Model.CurrentCV.FileSize)
                </p>
            </div>

            <div class="d-flex gap-2" style="margin-bottom: 2rem;">
                <form method="post" asp-page-handler="Download" class="d-inline">
                    <button type="submit" class="btn-artisan-outline">View CV</button>
                </form>
                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete your CV?');">
                    <button type="submit" class="btn-artisan-danger">Delete</button>
                </form>
            </div>

            <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--color-border);" />

            <p style="color: var(--color-secondary-text); margin-bottom: 1rem;">Replace your CV with a new document.</p>

            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="artisan-form">
                <div class="form-group">
                    <label for="cvFile">Choose new CV / Resume</label>
                    <input type="file" id="cvFile" name="cvFile" accept=".pdf,.doc,.docx" class="form-control" required />
                    <div class="field-hint">
                        Accepted formats: PDF, DOC, DOCX<br />
                        Maximum size: 10 MB
                    </div>
                </div>
                <button type="submit" class="btn-artisan-primary">Replace CV</button>
            </form>
        }
    </div>
</div>

@functions {
    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
