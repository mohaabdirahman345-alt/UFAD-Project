@page
@model UnifiedFreelanceArtisansDirectory.Areas.ServiceProvider.Pages.Profile.EditModel
@{
    ViewData["Title"] = "Service Provider Profile";
}

<div style="max-width:720px;">
    <p class="text-muted">This is what clients see on your public profile.</p>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert-artisan alert-artisan-success">@Model.StatusMessage</div>
    }

    @switch (Model.ApprovalStatus)
    {
        case UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.Draft:
            <div class="alert-artisan">Your profile is still a draft — clients can't find you yet. Complete the fields below, then submit for review.</div>
            break;
        case UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.PendingApproval:
            <div class="alert-artisan">Your profile is waiting on administrator review before it goes live.</div>
            break;
        case UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.Approved:
            <div class="alert-artisan alert-artisan-success">Your profile is approved and visible in search.</div>
            break;
        case UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.Rejected:
            <div class="alert-artisan alert-artisan-danger">Your last submission wasn't approved. Update your profile and submit again.</div>
            break;
    }

    <div style="margin-bottom: 1.5rem;">
        <a asp-area="ServiceProvider" asp-page="/CV/Manage" class="btn-artisan-outline">Manage CV / Resume</a>
    </div>

    <form method="post" class="artisan-card artisan-form">
        <div asp-validation-summary="ModelOnly" class="text-danger-artisan mb-3"></div>

        <label asp-for="Input.Headline">Professional headline</label>
        <input asp-for="Input.Headline" class="form-control" />
        <span asp-validation-for="Input.Headline" class="text-danger-artisan"></span>

        <label asp-for="Input.Bio">Bio</label>
        <textarea asp-for="Input.Bio" rows="4" class="form-control"></textarea>

        <div class="row">
            <div class="col-md-6">
                <label asp-for="Input.CategoryId">Service category</label>
                <select asp-for="Input.CategoryId" class="form-control">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.YearsOfExperience">Years of experience</label>
                <input asp-for="Input.YearsOfExperience" type="number" min="0" max="60" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Input.HourlyRate">Hourly rate (USD)</label>
                <input asp-for="Input.HourlyRate" type="number" min="0" step="0.5" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <label asp-for="Input.Address">Address</label>
                <input asp-for="Input.Address" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.PhoneNumber">Phone number</label>
                <input asp-for="Input.PhoneNumber" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.AvailabilityStatus">Availability</label>
                <select asp-for="Input.AvailabilityStatus" class="form-control">
                    <option value="0">Available</option>
                    <option value="1">Busy</option>
                    <option value="2">Unavailable</option>
                </select>
            </div>
        </div>

        <label>Skills</label>
        <div class="field-hint">Select every skill that applies — clients filter and search by these.</div>
        <div class="row mb-3">
            @foreach (var group in Model.AllSkills.GroupBy(s => s.Category.Name))
            {
                <div class="col-md-6 mb-2">
                    <strong style="font-size:0.9rem;color:var(--color-navy);">@group.Key</strong>
                    @foreach (var skill in group)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Input.SkillIds" value="@skill.Id"
                                   id="skill-@skill.Id" checked="@Model.Input.SkillIds.Contains(skill.Id)" />
                            <label class="form-check-label" for="skill-@skill.Id" style="font-weight:400;">@skill.Name</label>
                        </div>
                    }
                </div>
            }
        </div>

        <button type="submit" class="btn-artisan-primary">Save Changes</button>
    </form>

    @if (Model.ApprovalStatus is UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.Draft or UnifiedFreelanceArtisansDirectory.Domain.Enums.ApprovalStatus.Rejected)
    {
        <form method="post" asp-page-handler="SubmitForApproval" class="mt-3">
            <button type="submit" class="btn-artisan-secondary">Submit Profile for Approval</button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
