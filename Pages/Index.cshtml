<!-- ======================================================
     FAQ
     ====================================================== -->
<section id="faq" class="lp-section lp-section--gray">
    <div class="container">
        <div class="lp-section__head lp-section__head--center">
            <span class="lp-label">Have questions?</span>
            <h2 class="lp-section__title">Frequently Asked Questions</h2>
        </div>
        <div class="lp-faq">
            <div class="lp-faq__item">
                <button class="lp-faq__q" aria-expanded="false">
                    <span>What is UFAD Garowe?</span>
                    <svg class="lp-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="lp-faq__a">UFAD Garowe is a local platform connecting clients with verified freelance professionals and skilled artisans in Garowe — electricians, carpenters, tailors, developers, and more.</div>
            </div>
            <div class="lp-faq__item">
                <button class="lp-faq__q" aria-expanded="false">
                    <span>How do I hire a service provider?</span>
                    <svg class="lp-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="lp-faq__a">Browse or search for a professional, view their profile and reviews, then click "Send Request" to describe your job. The provider will respond directly to you.</div>
            </div>
            <div class="lp-faq__item">
                <button class="lp-faq__q" aria-expanded="false">
                    <span>How are service providers verified?</span>
                    <svg class="lp-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="lp-faq__a">Every provider submits a complete profile that is manually reviewed by our admin team before being approved and made visible in search.</div>
            </div>
            <div class="lp-faq__item">
                <button class="lp-faq__q" aria-expanded="false">
                    <span>Is UFAD Garowe free?</span>
                    <svg class="lp-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="lp-faq__a">Yes. Both clients and providers can join for free. We don't charge platform fees — all pricing is agreed directly between you and the provider.</div>
            </div>
            <div class="lp-faq__item">
                <button class="lp-faq__q" aria-expanded="false">
                    <span>Can I register as a service provider?</span>
                    <svg class="lp-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="lp-faq__a">Absolutely! Sign up, select "Service Provider", fill in your profile with skills and experience, and submit for admin review. Once approved you'll appear in search results.</div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================
     BOTTOM CTA BAND
     ====================================================== -->
<section class="lp-cta-band">
    <div class="container lp-cta-band__inner">
        <div>
            <h2 class="lp-cta-band__title">Ready to get started?</h2>
            <p class="lp-cta-band__sub">Join hundreds of professionals and clients already using UFAD Garowe.</p>
        </div>
        <div class="lp-cta-band__actions">
            <a class="lp-btn-primary lp-btn-primary--large" asp-page="/Browse">Find an Expert</a>
            <a class="lp-btn-ghost" asp-area="Identity" asp-page="/Account/Register">Become a Provider</a>
        </div>
    </div>
</section>

@section Scripts {
<script>
// FAQ accordion
document.querySelectorAll('.lp-faq__q').forEach(btn => {
    btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.lp-faq__q').forEach(b => {
            b.setAttribute('aria-expanded', 'false');
            b.closest('.lp-faq__item').classList.remove('open');
        });
        if (!expanded) {
            btn.setAttribute('aria-expanded', 'true');
            btn.closest('.lp-faq__item').classList.add('open');
        }
    });
});
</script>
}
