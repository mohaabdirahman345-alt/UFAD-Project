@using Microsoft.AspNetCore.Identity
@using UnifiedFreelanceArtisansDirectory.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationSvc
@{
    var currentPath = Context.Request.Path.Value ?? "";
    bool IsActive(string path) => currentPath.Equals(path, StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);

    var isAdmin = User.IsInRole("Administrator");
    var isServiceProvider = User.IsInRole("ServiceProvider");
    var isClient = User.IsInRole("Client");
    var areaRole = isAdmin ? "Administrator" : isServiceProvider ? "Service Provider" : isClient ? "Client" : "Guest";

    var notificationCount = 0;
    var notificationHref = "#";
    var userId = UserManager.GetUserId(User);

    if (!string.IsNullOrEmpty(userId) && (isAdmin || isServiceProvider || isClient))
    {
        notificationCount = await NotificationSvc.GetUnreadCountAsync(userId);

        if (isAdmin)
        {
            notificationHref = Url.Page("/Notifications/Index", new { area = "Admin" }) ?? "#";
        }
        else if (isServiceProvider)
        {
            notificationHref = Url.Page("/Notifications/Index", new { area = "ServiceProvider" }) ?? "#";
        }
        else
        {
            notificationHref = Url.Page("/Notifications/Index", new { area = "Client" }) ?? "#";
        }
    }

    var currentUser = !string.IsNullOrEmpty(userId) ? await UserManager.FindByIdAsync(userId) : null;
    var userAvatar = currentUser?.ProfileImagePath;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — UFAD Garowe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <div class="sidebar-brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3L4 7.5V14.5C4 19.2 7.4 23.5 12 24.5C16.6 23.5 20 19.2 20 14.5V7.5L12 3Z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M8.5 13.5L11 16L15.5 10" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <span>UFAD Garowe</span>
            </div>

            <nav class="sidebar-nav">
                @if (isAdmin)
                {
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Overview</span>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Dashboard") ? "active" : "")" asp-area="Admin" asp-page="/Dashboard">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("dashboard")" /></span> Dashboard
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Directory</span>
                        <a class="sidebar-nav-link @(IsActive("/Admin/ServiceProviders") ? "active" : "")" asp-area="Admin" asp-page="/ServiceProviders/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("providers")" /></span> Service Providers
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Approvals") ? "active" : "")" asp-area="Admin" asp-page="/Approvals/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("approvals")" /></span> Profile Approvals
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Requests") ? "active" : "")" asp-area="Admin" asp-page="/Requests/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("requests")" /></span> Service Requests
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Categories") ? "active" : "")" asp-area="Admin" asp-page="/Categories/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("categories")" /></span> Categories
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Skills") ? "active" : "")" asp-area="Admin" asp-page="/Skills/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("skills")" /></span> Skills
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Oversight</span>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Reviews") ? "active" : "")" asp-area="Admin" asp-page="/Reviews/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("reviews")" /></span> Reviews
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Reports") ? "active" : "")" asp-area="Admin" asp-page="/Reports/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("reports")" /></span> Reports
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Users") ? "active" : "")" asp-area="Admin" asp-page="/Users/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("users")" /></span> Users
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Account</span>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Notifications") ? "active" : "")" asp-area="Admin" asp-page="/Notifications/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("bell")" /></span> Notifications
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Admin/Settings") ? "active" : "")" asp-area="Admin" asp-page="/Settings/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("settings")" /></span> Settings
                        </a>
                    </div>
                }
                else if (isServiceProvider)
                {
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Overview</span>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Dashboard") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Dashboard">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("dashboard")" /></span> Dashboard
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">My Business</span>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Profile") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Profile/Edit">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("profile")" /></span> My Profile
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Portfolio") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Portfolio/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("portfolio")" /></span> Portfolio
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Requests") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Requests/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("requests")" /></span> Service Requests
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/CompletedJobs") ? "active" : "")" asp-area="ServiceProvider" asp-page="/CompletedJobs/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("completed")" /></span> Completed Jobs
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Reviews") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Reviews/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("reviews")" /></span> Reviews
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Account</span>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Notifications") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Notifications/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("bell")" /></span> Notifications
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/ServiceProvider/Settings") ? "active" : "")" asp-area="ServiceProvider" asp-page="/Settings/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("settings")" /></span> Settings
                        </a>
                    </div>
                }
                else if (isClient)
                {
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Overview</span>
                        <a class="sidebar-nav-link @(IsActive("/Client/Dashboard") ? "active" : "")" asp-area="Client" asp-page="/Dashboard">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("dashboard")" /></span> Dashboard
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Directory</span>
                        <a class="sidebar-nav-link @(IsActive("/Browse") ? "active" : "")" asp-area="" asp-page="/Browse">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("find")" /></span> Find Service Providers
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Client/Requests") ? "active" : "")" asp-area="Client" asp-page="/Requests/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("requests")" /></span> My Requests
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Client/Favorites") ? "active" : "")" asp-area="Client" asp-page="/Favorites">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("saved")" /></span> Saved Providers
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Client/Reviews") ? "active" : "")" asp-area="Client" asp-page="/Reviews/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("reviews")" /></span> Reviews
                        </a>
                    </div>
                    <div class="sidebar-nav-group">
                        <span class="sidebar-nav-label">Account</span>
                        <a class="sidebar-nav-link @(IsActive("/Client/Notifications") ? "active" : "")" asp-area="Client" asp-page="/Notifications/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("bell")" /></span> Notifications
                        </a>
                        <a class="sidebar-nav-link @(IsActive("/Client/Settings") ? "active" : "")" asp-area="Client" asp-page="/Settings/Index">
                            <span class="sidebar-nav-icon"><partial name="_Icon" model="@("settings")" /></span> Settings
                        </a>
                    </div>
                }
            </nav>

            <div class="sidebar-footer">
                <a class="sidebar-nav-link" asp-area="" asp-page="/Index">
                    <span class="sidebar-nav-icon"><partial name="_Icon" model="@("find")" /></span> Public Site
                </a>
            </div>
        </aside>

        <div class="dashboard-main">
            <header class="dashboard-topbar">
                <button type="button" class="topbar-icon-btn d-lg-none" onclick="document.getElementById('dashboardSidebar').classList.toggle('open')" aria-label="Toggle navigation">☰</button>
                <h1 class="topbar-title">@ViewData["Title"]</h1>

                <div class="topbar-actions">
                    <button type="button" class="topbar-icon-btn" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode">
                        <span class="theme-toggle-icon icon-sun">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        </span>
                        <span class="theme-toggle-icon icon-moon d-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"/></svg>
                        </span>
                    </button>

                    <a class="topbar-icon-btn" href="@notificationHref" aria-label="Notifications" title="Notifications">
                        <partial name="_Icon" model="@("bell")" />
                        @if (notificationCount > 0)
                        {
                            <span class="badge-dot">@(notificationCount > 9 ? "9+" : notificationCount.ToString())</span>
                        }
                    </a>

                    <div class="dropdown d-inline-block">
                        <button type="button" class="profile-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false" title="Account Menu">
                            @if (!string.IsNullOrEmpty(userAvatar))
                            {
                                <img src="@userAvatar" alt="Avatar" class="avatar-topbar-img" />
                            }
                            else
                            {
                                <span class="avatar-initial">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end profile-dropdown-menu shadow-lg border-0 p-3 mt-2">
                            <div class="profile-dropdown-header d-flex align-items-center gap-2 pb-3 mb-2 border-bottom">
                                <div class="profile-avatar-icon flex-shrink-0" style="overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(userAvatar))
                                    {
                                        <img src="@userAvatar" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    }
                                </div>
                                <div class="text-truncate" style="max-width: 210px;">
                                    <div class="fw-semibold text-dark text-truncate" style="font-size: 0.875rem;" title="@User.Identity?.Name">@User.Identity?.Name</div>
                                    <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.75rem;">@areaRole</span>
                                </div>
                            </div>

                            <div class="profile-dropdown-section mb-3">
                                <label class="form-label text-muted extra-small text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Translation</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10z"/><path d="M2 12h20"/></svg>
                                    </span>
                                    <select class="form-select form-select-sm border-start-0 bg-light" aria-label="Language">
                                        <option value="en" selected>English</option>
                                        <option value="so">Soomaali</option>
                                    </select>
                                </div>
                            </div>

                            <div class="profile-dropdown-section mb-3">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="text-muted extra-small text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Appearance</span>
                                    <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                                        <span class="theme-toggle-icon icon-sun">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                                        </span>
                                        <span class="theme-toggle-icon icon-moon d-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"/></svg>
                                        </span>
                                        <span class="themeLabelText extra-small fw-semibold ms-1">Light</span>
                                    </button>
                                </div>
                            </div>

                            <div class="pt-2 border-top">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 rounded-2 py-2 px-2 fw-medium">
                                        <span class="profile-dropdown-icon"><partial name="_Icon" model="@("logout")" /></span>
                                        <span>Log Out</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <main class="dashboard-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
